---
import { EstadoProyecto } from '../components/EstadoProyecto';
import { ACTUALIZADO_AL } from '../engine';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Calculadora reforma tributaria 2026: ¿cuánto te afecta?">
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">
      Calculadora reforma tributaria 2026
    </h1>
    <p class="mt-4 text-lg text-stone-700">
      Estima el efecto del proyecto de ley 477 de 2026 sobre tu salario, tu
      canasta y otros impuestos.
    </p>
    <EstadoProyecto />
    <aside class="mt-8 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-stone-800">
      <p>
        Tus datos no salen de tu navegador. Es un proyecto de ley en trámite;
        puede cambiar. Estimación aproximada, no es asesoría tributaria.
        Parámetros actualizados al {ACTUALIZADO_AL}.
      </p>
    </aside>
  </main>
</Layout>
